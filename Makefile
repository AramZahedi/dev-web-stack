MODULE  := github.com/AramZahedi/dev-web-stack
VERSION := $(shell git describe --tags --dirty 2>/dev/null || echo dev)
COMMIT  := $(shell git rev-parse --short HEAD 2>/dev/null)
LDFLAGS := -s -w \
	-X $(MODULE)/internal/version.Version=$(VERSION) \
	-X $(MODULE)/internal/version.Commit=$(COMMIT)

PHP_LINE       ?= 8.4
PHP_REVISION   ?= 1
PHP_OUTPUT     ?= dist/php
PHP_VERSION    ?= $(shell sed -n 's/^PHP_$(subst .,_,$(PHP_LINE))_VERSION=//p' build/php/extensions.lock 2>/dev/null)
PHP_ARTIFACT   ?= $(PHP_OUTPUT)/php-$(PHP_VERSION)-r$(PHP_REVISION)-linux-x64.tar.gz
# Required for php-catalog: the real HTTPS host where release assets are published.
PHP_BASE_URL   ?=
PHP_SMOKE_BIN  ?=
# Required for php-catalog-merge: the php-catalog.json artifact generated by
# .github/workflows/php.yml and the catalog document to merge it into.
PHP_CATALOG_JSON  ?=
CATALOG           ?=
PHP_ARTIFACTS_DIR ?= artifacts
PHP_CATALOG_CHECK ?= 0

.PHONY: build build-windows build-agent test test-linux test-windows-cross lint ui e2e clean php-build php-smoke php-catalog php-catalog-merge php-test release release-test release-windows release-windows-test acceptance

# Cross-build the Windows daemon and helper. The output stays in dist/ so the
# same artifacts feed packaging and the manual Windows CI dispatch.
build-windows:
	mkdir -p dist
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags '$(LDFLAGS)' -o dist/devstack.exe ./cmd/devstack
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags '$(LDFLAGS)' -o dist/devstack-helper.exe ./cmd/devstack-helper

# The Linux agent is built for the WSL rootfs. Lane B creates cmd/devstack-agent;
# this target is part of the frozen build matrix from T0.1 onward.
build-agent:
	mkdir -p dist
	GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags '$(LDFLAGS)' -o dist/devstack-agent ./cmd/devstack-agent

# Compile every package, test package, and vet check for Windows without
# executing Windows binaries on the host. Run natively on Windows for tests.
test-windows-cross:
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build ./...
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go vet ./...
	GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go test -run '^$$' -exec 'true' ./...

# Linux regression suite; run in WSL ext4 or on a Linux checkout.
test-linux:
	go test ./...

build: ui
	mkdir -p dist
	CGO_ENABLED=0 go build -trimpath -ldflags '$(LDFLAGS)' -o dist/devstack ./cmd/devstack
	CGO_ENABLED=0 go build -trimpath -ldflags '$(LDFLAGS)' -o dist/devstack-helper ./cmd/devstack-helper

test:
	go test ./...

lint:
	golangci-lint run

ui:
	@if [ -f ui/package.json ]; then \
		cd ui && npm ci && npm run build; \
	else \
		echo "ui: no package.json yet, nothing to build"; \
	fi

e2e: build
	E2E_SKIP_BUILD=1 bash test/e2e/linux.sh

# Full Linux M1 acceptance. The runner is unprivileged and exits 0 only when
# no phase FAILs; SKIP and BLOCKED gates are printed and counted. Pass
# ACCEPTANCE_ARGS="--quick" to skip the race detector, or
# ACCEPTANCE_ARGS="--quick --skip-playwright" for a faster pass.
acceptance:
	bash test/acceptance/m1.sh $(ACCEPTANCE_ARGS)

clean:
	rm -rf dist

# Build the local Linux amd64 release archive with checksums. VERSION is a
# plain semver; build/release.sh normalizes a leading "v" and validates it.
release:
	bash build/release.sh --version "$(VERSION)"

release-test:
	bash test/release/release_test.sh

# Build the local Windows amd64 release archive with checksums, rootfs, and SBOM.
release-windows:
	bash build/release-windows.sh --version "$(VERSION)"

release-windows-test:
	bash test/release/release_windows_test.sh

# PHP artifacts are built and published by the php.yml CI workflow. These
# targets are for contributors who have the build dependencies from
# build/php/README.md. The production catalog stays empty until the release
# job publishes the resulting checksummed archives.
php-build:
	@test -n "$(PHP_VERSION)" || { echo "no locked PHP version for line $(PHP_LINE); run build/php/update-lock.sh" >&2; exit 1; }
	bash build/php/build.sh --line "$(PHP_LINE)" --version "$(PHP_VERSION)" --revision "$(PHP_REVISION)" --output "$(PHP_OUTPUT)"

php-smoke:
	@test -f "$(PHP_ARTIFACT)" || { echo "missing $(PHP_ARTIFACT); run make php-build" >&2; exit 1; }
	PHP_SMOKE_BIN="$(PHP_SMOKE_BIN)" bash build/php/smoke.sh "$(PHP_ARTIFACT)"

php-catalog:
	@case "$(PHP_BASE_URL)" in \
		https://*) ;; \
		*) echo "PHP_BASE_URL must be a non-empty https:// URL for the published artifact host" >&2; exit 1 ;; \
	esac
	@test -f "$(PHP_ARTIFACT)" || { echo "missing $(PHP_ARTIFACT); run make php-build" >&2; exit 1; }
	@mkdir -p "$(PHP_OUTPUT)"
	@sha=$$(sha256sum "$(PHP_ARTIFACT)" | cut -d' ' -f1); \
	size=$$(stat -c '%s' "$(PHP_ARTIFACT)"); \
	go run ./cmd/phpcatalog \
		--version "$(PHP_VERSION)" \
		--revision "$(PHP_REVISION)" \
		--artifact "$(PHP_ARTIFACT)" \
		--sha256 "$$sha" \
		--size "$$size" \
		--base-url "$(PHP_BASE_URL)" \
		--output "$(PHP_OUTPUT)/php-$(PHP_VERSION)-r$(PHP_REVISION).json"

# Merge the PHP workflow's php-catalog.json artifact into a catalog document.
# This is a gated release step, not a CI commit: the production catalog stays
# Node-only until real checksummed 8.2-8.5 artifacts are published. Passing
# CATALOG, PHP_CATALOG_JSON, and PHP_ARTIFACTS_DIR explicitly (or accepting the
# documented artifacts/ default) is required so a typo cannot update the
# embedded catalog by accident. The artifact directory must contain the exact
# tarballs named by the catalog entries; missing, extra, non-regular, or
# checksum/size-mismatched files fail the merge. PHP_CATALOG_CHECK=1 validates
# and writes nothing.
php-catalog-merge:
	@test -n "$(PHP_CATALOG_JSON)" || { echo "PHP_CATALOG_JSON is required (path to php-catalog.json)" >&2; exit 1; }
	@test -n "$(CATALOG)" || { echo "CATALOG is required (path to the catalog document to update)" >&2; exit 1; }
	@test -f "$(PHP_CATALOG_JSON)" || { echo "missing PHP catalog JSON: $(PHP_CATALOG_JSON)" >&2; exit 1; }
	@test -f "$(CATALOG)" || { echo "missing catalog document: $(CATALOG)" >&2; exit 1; }
	@test -d "$(PHP_ARTIFACTS_DIR)" || { echo "missing PHP artifacts directory: $(PHP_ARTIFACTS_DIR)" >&2; exit 1; }
	go run ./cmd/catalogmerge --catalog "$(CATALOG)" --php-catalog "$(PHP_CATALOG_JSON)" --artifacts "$(PHP_ARTIFACTS_DIR)" $(if $(filter 1,$(PHP_CATALOG_CHECK)),--check,)

php-test:
	go test ./cmd/phpcatalog ./cmd/php-smoke
	go vet ./cmd/phpcatalog ./cmd/php-smoke
	bash test/php/smoke_links_test.sh
	bash -n build/php/*.sh test/php/*.sh
	@if command -v shellcheck >/dev/null 2>&1; then \
		shellcheck --severity=error build/php/*.sh test/php/*.sh; \
	else \
		echo "php-test: shellcheck not installed, skipped"; \
	fi
