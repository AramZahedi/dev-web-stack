# Copy to /etc/devstack/helper.yaml. install.sh generates this file with the
# invoking user's UID. Values omitted from the file keep the helper defaults;
# command-line flags override the file.
socket: /run/devstack-helper/helper.sock
state_dir: /var/lib/devstack-helper
hosts: /etc/hosts

# Empty trusts the distribution's detected CA anchor directory
# (/etc/pki/ca-trust/source/anchors on Fedora, /usr/local/share/ca-certificates
# on Debian/Ubuntu). Set a path to override it.
trust_dir: ""

# Only this UID may call the helper. This must be the user who runs devstack.
allow_uid: 1000

# Privileged listeners owned by the root helper. They forward to the daemon's
# unprivileged proxy ports.
forward_http_port: 80
forward_https_port: 443
proxy_http_port: 8080
proxy_https_port: 8443

log_level: info
