-- MySQL/MariaDB users and grants. seed.sh substitutes __E2E_*_PASSWORD__ with
-- ephemeral hex secrets before running this file.
CREATE USER IF NOT EXISTS 'e2e_user'@'%' IDENTIFIED BY '__E2E_USER_PASSWORD__';
ALTER USER 'e2e_user'@'%' IDENTIFIED BY '__E2E_USER_PASSWORD__';
CREATE USER IF NOT EXISTS 'e2e_user_ro'@'%' IDENTIFIED BY '__E2E_USER_RO_PASSWORD__';
ALTER USER 'e2e_user_ro'@'%' IDENTIFIED BY '__E2E_USER_RO_PASSWORD__';
CREATE USER IF NOT EXISTS 'e2e_user_admin'@'%' IDENTIFIED BY '__E2E_USER_ADMIN_PASSWORD__';
ALTER USER 'e2e_user_admin'@'%' IDENTIFIED BY '__E2E_USER_ADMIN_PASSWORD__';
CREATE USER IF NOT EXISTS 'e2e_user_case'@'%' IDENTIFIED BY '__E2E_USER_CASE_PASSWORD__';
ALTER USER 'e2e_user_case'@'%' IDENTIFIED BY '__E2E_USER_CASE_PASSWORD__';
CREATE USER IF NOT EXISTS 'e2e_user_host_local'@'localhost' IDENTIFIED BY '__E2E_USER_HOST_LOCAL_PASSWORD__';
ALTER USER 'e2e_user_host_local'@'localhost' IDENTIFIED BY '__E2E_USER_HOST_LOCAL_PASSWORD__';
CREATE USER IF NOT EXISTS 'e2e_user_host_net'@'10.%' IDENTIFIED BY '__E2E_USER_HOST_NET_PASSWORD__';
ALTER USER 'e2e_user_host_net'@'10.%' IDENTIFIED BY '__E2E_USER_HOST_NET_PASSWORD__';

GRANT SELECT, INSERT, UPDATE, DELETE ON `e2e_app`.* TO 'e2e_user'@'%';
GRANT SELECT ON `e2e_app`.* TO 'e2e_user_ro'@'%';
GRANT ALL PRIVILEGES ON `e2e_app`.* TO 'e2e_user_admin'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON `e2e_app`.* TO 'e2e_user_case'@'%';
GRANT SELECT ON `e2e_app`.* TO 'e2e_user_host_local'@'localhost';
GRANT SELECT ON `e2e_app`.* TO 'e2e_user_host_net'@'10.%';
FLUSH PRIVILEGES;
