{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AramZahedi/dev-web-stack/test/e2e/database-management/results.schema.json",
  "title": "Database management E2E results",
  "type": "object",
  "required": ["schema_version", "updated_at", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "environment",
          "status",
          "evidence",
          "commit",
          "recorded_at",
          "residual_risk",
          "notes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^(E2E-[0-9]{2}|HARNESS-[A-Z0-9-]+)$"},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "environment": {
            "enum": ["WIN", "WIN-REAL", "LIN-UBE", "LIN-DEB", "LIN-FED", "UI-MOCK", "UI-LIVE", "CLI-PS5", "CLI-PS7", "CLI-BASH"]
          },
          "status": {"enum": ["PASS", "FAIL", "SKIP", "BLOCKED"]},
          "evidence": {"type": "string"},
          "commit": {"type": "string"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "residual_risk": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
